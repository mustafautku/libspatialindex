		{
			"label": "_build: CMake config & Build & Install libspatialindex LIBRARY",
			"type": "shell",
			"command": "${workspaceFolder}/.vscode/Build_library.sh",
			"group": {
				"kind": "build",
				"isDefault": false
			},
			"problemMatcher": []
		},
		{
			"label": "_build: build-and-install-libspatialindex",  // do not reconfigure the cmake
			"type": "shell",
			"command": "cmake",
			"args": [
				"--build", "mybuild",
				"--target", "install",
				"-j", "8"
			],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
